{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "services": {
    "web": {
      "root": ".",
      "framework": "vite"
    },
    "api": {
      "root": "chatbot/",
      "framework": "fastapi",
      "entrypoint": "app:app"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Resource-Policy", "value": "same-origin" },
        { "key": "Origin-Agent-Cluster", "value": "?1" },
        { "key": "X-Permitted-Cross-Domain-Policies", "value": "none" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/privacy",
      "destination": "/privacy-policy",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "api"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/privacy-policy",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/brand/(.*)",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/.well-known/security.txt",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/favicon.ico",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/placeholder.svg",
      "destination": {
        "service": "web"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "api"
      }
    }
  ]
}
