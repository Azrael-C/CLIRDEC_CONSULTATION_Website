{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": ".",
      "framework": "vite",
      "routePrefix": "/",
      "excludeFiles": [
        "api/**",
        "chatbot/**",
        "requirements.txt",
        "pyproject.toml",
        ".python-version"
      ]
    },
    "api": {
      "entrypoint": "chatbot/app.py",
      "routePrefix": "/api",
      "maxDuration": 30,
      "memory": 1024,
      "includeFiles": [
        "chatbot/**"
      ]
    }
  }
}
