ALLOWED_ORIGINS=http://localhost:5173,https://clsu-faculty-connect.vercel.app,https://clsufacultyconnect.com,https://www.clsufacultyconnect.com
FAQ_CACHE_SECONDS=300
FACULTY_CACHE_SECONDS=60
SUPABASE_URL=https://your-project.supabase.co
# Required for approved FAQ loading. Use a current, scoped sb_secret_ key and
# never expose it through a VITE_ variable.
SUPABASE_SECRET_KEY=your-server-only-secret-key
OFFICIAL_SUPPORT_CONTACT=the official CLIRDEC or MISO contact channel
TURNSTILE_SECRET_KEY=your-server-only-turnstile-secret
REQUIRE_TURNSTILE=true
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_BURST_LIMIT_PER_10_SECONDS=8
CHAT_TRUST_TTL_SECONDS=1800
# Optional dedicated HMAC signer. When omitted, the server derives chat trust
# from TURNSTILE_SECRET_KEY without exposing either value to the browser.
# CHAT_TRUST_SECRET=generate-a-long-random-server-only-secret
ENABLE_API_DOCS=false
MAX_REQUEST_BODY_BYTES=16384
REQUEST_TIMEOUT_SECONDS=12
