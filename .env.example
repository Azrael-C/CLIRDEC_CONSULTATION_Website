
# Public browser configuration only. Copy this file to .env.local.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-sb-publishable-key
# Temporary legacy fallback only; remove after all environments migrate.
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key
VITE_CHATBOT_URL=http://localhost:8000
VITE_TURNSTILE_SITE_KEY=your-public-cloudflare-turnstile-site-key

# Never add SUPABASE_SERVICE_ROLE_KEY, RESEND_API_KEY, or other server
# credentials to a VITE_ variable. Configure those in Supabase/Render.
